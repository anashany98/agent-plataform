map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

upstream portal_upstream { server portal:8080; }
upstream bridge_upstream { server bridge-api:8005; }
upstream chatwoot_upstream { server chatwoot-web:3000; }
upstream flowwink_upstream { server flowwink-app:80; }
upstream activepieces_upstream { server activepieces-app:80; }

server {
  listen 8080 default_server;
  server_name _;
  location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }
  location / { return 444; }
}

server {
  listen 8080;
  server_name ${PORTAL_HOST} localhost 127.0.0.1;
  client_max_body_size 25m;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }
  location /api/bridge/ {
    proxy_pass http://bridge_upstream/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 90s;
  }
  location / {
    proxy_pass http://portal_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 8080;
  server_name ${API_HOST};
  client_max_body_size 25m;
  add_header X-Content-Type-Options "nosniff" always;
  location / {
    proxy_pass http://bridge_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 90s;
  }
}

server {
  listen 8080;
  server_name ${CHATWOOT_HOST};
  client_max_body_size 25m;
  location / {
    proxy_pass http://chatwoot_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 90s;
  }
}

server {
  listen 8080;
  server_name ${FLOWWINK_HOST};
  location / {
    proxy_pass http://flowwink_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 8080;
  server_name ${ACTIVEPIECES_HOST};
  client_max_body_size 25m;
  location / {
    proxy_pass http://activepieces_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }
}
