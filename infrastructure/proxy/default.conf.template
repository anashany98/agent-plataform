map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# El único salto que envía X-Forwarded-Proto en producción es tls-proxy. En
# core el puerto se liga a loopback, por lo que no se acepta tráfico remoto.
map $http_x_forwarded_proto $forwarded_proto {
  default $scheme;
  https https;
}

upstream portal_upstream { server portal:8080; }
upstream bridge_upstream { server bridge-api:8005; }
# chatwoot y activepieces son opcionales (perfil core arranca sin ellos).
# Se resuelven en tiempo de petición (resolver + variable) para que nginx no
# falle al parsear la config cuando el servicio no está levantado; en ese caso
# la petición recibe 502 en lugar de tumbar el arranque del proxy.

server {
  listen 8080 default_server;
  server_name _;
  location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }
  location / { return 444; }
}

server {
  listen 8080;
  server_name ${PORTAL_HOST} localhost 127.0.0.1;
  client_max_body_size 25m;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }
  # Readiness atraviesa proxy -> API -> PostgreSQL. El health check del
  # contenedor no declara el edge listo si solo nginx está vivo.
  location = /readyz {
    proxy_pass http://bridge_upstream/ready;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
  }
  # Import endpoints se registran en la app con el prefijo completo
  # /api/bridge/import* (no como el resto de rutas). Se pasan SIN reescribir el
  # prefijo: el bloque /api/bridge/ lo elimina y provocaría un 404.
  location ^~ /api/bridge/import {
    proxy_pass http://bridge_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    # Imports masivos incluyen el reindexado semántico inline (10k+ productos
    # pueden tardar varios minutos con LM Studio); 90s cortaba la respuesta
    # con un 504 aunque el trabajo seguía en el servidor.
    proxy_read_timeout 900s;
  }
  # El sync de PrestaShop consulta la tienda real producto a producto
  # (combinaciones, stock, categorías e impuestos) y puede tardar varios
  # minutos en catálogos grandes; 90s cortaba la respuesta con un 504 aunque
  # el trabajo seguía en el servidor.
  location ^~ /api/bridge/integrations/prestashop/ {
    proxy_pass http://bridge_upstream/integrations/prestashop/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 900s;
  }
  location /api/bridge/ {
    proxy_pass http://bridge_upstream/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 90s;
  }
  location / {
    proxy_pass http://portal_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }
}

server {
  listen 8080;
  server_name ${API_HOST};
  client_max_body_size 25m;
  add_header X-Content-Type-Options "nosniff" always;
  location / {
    proxy_pass http://bridge_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 90s;
  }
}

server {
  listen 8080;
  server_name ${CHATWOOT_HOST};
  # Chatwoot autentica su API con `api_access_token`; limitar la aceptación
  # de headers con guion bajo a este virtual host evita ampliar la superficie
  # del portal y de Bridge.
  underscores_in_headers on;
  client_max_body_size 25m;
  location / {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $chatwoot_upstream_url http://chatwoot-web:3000;
    proxy_pass $chatwoot_upstream_url;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 90s;
  }
}

server {
  listen 8080;
  server_name ${FLOWWINK_HOST};
  location / {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $flowwink_upstream_url http://flowwink-app:80;
    proxy_pass $flowwink_upstream_url;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }
}

server {
  listen 8080;
  server_name ${ACTIVEPIECES_HOST};
  client_max_body_size 25m;
  location / {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $activepieces_upstream_url http://activepieces-app:80;
    proxy_pass $activepieces_upstream_url;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 120s;
  }
}
